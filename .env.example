# ==========================================
# AGGRESSOR UC BOT - ENVIRONMENT VARIABLES
# ==========================================
# Bu faylni .env deb nomlab, haqiqiy qiymatlarni kiriting.
# .env faylini hech qachon GitHub'ga yuklamang!

# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=1234567890:AAExampleTokenHereReplaceWithReal

# Admin Telegram ID lar (vergul bilan ajratilgan, bir nechta bo'lishi mumkin)
ADMIN_IDS=123456789,987654321

# To'lov uchun karta ma'lumotlari
CARD_NUMBER=8600 1234 5678 9012
CARD_OWNER=JOHN DOE

# Database fayl yo'li
DATABASE_PATH=data/aggressor_uc.db

# Bot username (contact/link uchun, @ belgisisiz)
BOT_USERNAME=aggressor_uc_bot

# Contact ma'lumotlari
CONTACT_PHONE=+998901234567
CONTACT_USERNAME=@aggressor_support

# Timezone (statistikada sana hisoblash uchun)
TIMEZONE=Asia/Tashkent
